{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=service-desc, </agents.json>; rel=describedby, </.well-known/ai-plugin.json>; rel=ai-plugin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        { "type": "header", "key": "accept", "value": "text/markdown(.*)" }
      ],
      "destination": "/index.md"
    },
    {
      "source": "/blog/:slug",
      "has": [
        { "type": "header", "key": "accept", "value": "text/markdown(.*)" }
      ],
      "destination": "/blog/:slug.md"
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "mode", "value": "agent" }],
      "destination": "/api/agent"
    }
  ]
}
